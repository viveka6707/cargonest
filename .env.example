# Flask
CARGONEST_SECRET=replace-with-a-long-random-secret
ADMIN_EMAIL=admin@cargonest.local
ADMIN_PASSWORD=ChangeMe@123

# MySQL Connector/Python (XAMPP/WAMP default often root with blank password)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=cargonest

# Firebase Realtime Database (IoT data only)
FIREBASE_DB_URL=https://YOUR-PROJECT-default-rtdb.firebaseio.com
FIREBASE_AUTH_TOKEN=
FIREBASE_SENSOR_PATH=/CargoNest/data
FIREBASE_MULTI_CONTAINER=0
